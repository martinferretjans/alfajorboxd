package views

import (
	db "alfajorboxd/db/sqlc"
	"fmt"
)

templ AlfajorPage(tema string, alfajor db.Alfajor, promedio float64, reviews []db.ListReviewsByAlfajorRow, usuarios []db.Usuario) {
	@Layout(alfajor.Name, tema, alfajorDetalle(alfajor, promedio, reviews, usuarios))
}

templ alfajorDetalle(alfajor db.Alfajor, promedio float64, reviews []db.ListReviewsByAlfajorRow, usuarios []db.Usuario) {
	<section class="detalle">
		<div class="detalle-poster">
			@Poster(alfajor.Name, alfajor.Imagen)
		</div>
		<div class="detalle-info">
			<h1>{ alfajor.Name }</h1>
			<p class="detalle-marca">de <strong>{ alfajor.Marca }</strong></p>
			if alfajor.Descripcion.Valid {
				<p class="detalle-descripcion">{ alfajor.Descripcion.String }</p>
			}
			<table class="detalle-datos">
				<tbody>
					<tr><th>Relleno</th><td>{ alfajor.Relleno }</td></tr>
					<tr>
						<th>Cobertura</th>
						if alfajor.Cobertura.Valid {
							<td>{ alfajor.Cobertura.String }</td>
						} else {
							<td>Sin cobertura</td>
						}
					</tr>
					<tr><th>Tapas</th><td>{ fmt.Sprint(alfajor.Tapas) }</td></tr>
					<tr><th>Precio</th><td>{ fmt.Sprintf("$%d", alfajor.Precio) }</td></tr>
				</tbody>
			</table>
		</div>
		<aside class="detalle-puntaje">
			<span class="puntaje-titulo">Calificación</span>
			if len(reviews) > 0 {
				<span class="puntaje-numero">{ fmt.Sprintf("%.2f", promedio) }</span>
				<span class="estrellas">{ estrellasPromedio(promedio) }</span>
				<span class="puntaje-cantidad">{ fmt.Sprintf("%d reviews", len(reviews)) }</span>
			} else {
				<span class="sin-reviews">Sin reviews</span>
			}
		</aside>
	</section>
	<section class="seccion">
		<div class="seccion-titulo">
			<h2>Reviews</h2>
		</div>
		<div id="lista-reviews-alfajor">
			if len(reviews) == 0 {
				<p class="vacio">Este alfajor todavía no tiene reviews.</p>
			}
			for _, r := range reviews {
				<article class="review">
					<div class="review-cuerpo">
						<div class="review-cabecera">
							<span><span class="review-usuario">{ r.Usuario }</span> <span class="estrellas">{ estrellas(r.Calificacion) }</span></span>
							<span class="review-fecha">{ r.Fecha.Format("02/01/2006") }</span>
						</div>
						if r.Comentario.Valid {
							<p class="review-comentario">{ r.Comentario.String }</p>
						}
					</div>
				</article>
			}
		</div>
	</section>
	<section class="seccion">
		<div class="seccion-titulo">
			<h2>Dejá tu review</h2>
		</div>
		@ReviewForm(alfajor.ID, usuarios)
	</section>
}
